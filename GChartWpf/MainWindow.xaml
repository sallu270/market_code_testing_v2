<Window x:Class="GChartWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GChartWpf.Controls"
        Title="GChart · Gap Entry Terminal" Width="1400" Height="900" MinWidth="1000" MinHeight="650"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>   <!-- navbar -->
            <RowDefinition Height="40"/>   <!-- ticker strip -->
            <RowDefinition Height="*"/>    <!-- content -->
            <RowDefinition Height="24"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ============ 1. NAVBAR (code type / mode) ============ -->
        <Border Grid.Row="0" Background="#101010" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="GChart" FontWeight="Black" FontSize="15" Foreground="{StaticResource Teal}"
                               VerticalAlignment="Center" Margin="12,0,10,0"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="NIFTY 50" IsChecked="True"
                                 Command="{Binding SetModeCommand}" CommandParameter="Nifty50"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="BANK NIFTY"
                                 Command="{Binding SetModeCommand}" CommandParameter="BankNifty"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="SENSEX"
                                 Command="{Binding SetModeCommand}" CommandParameter="Sensex"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="STOCKS"
                                 Command="{Binding SetModeCommand}" CommandParameter="Stocks"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="JOURNAL"
                                 Command="{Binding SetModeCommand}" CommandParameter="Journal"/>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="mode" Content="SETTINGS"
                                 Command="{Binding SetModeCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding ConnBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ConnText}" Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <!-- chart period keypad -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsChartMode, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Period" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton Style="{StaticResource SegButton}" GroupName="tf" Content="1"  IsChecked="True" Command="{Binding SetTimeframeCommand}" CommandParameter="1m"/>
                    <RadioButton Style="{StaticResource SegButton}" GroupName="tf" Content="3"  Command="{Binding SetTimeframeCommand}" CommandParameter="3m"/>
                    <RadioButton Style="{StaticResource SegButton}" GroupName="tf" Content="5"  Command="{Binding SetTimeframeCommand}" CommandParameter="5m"/>
                    <RadioButton Style="{StaticResource SegButton}" GroupName="tf" Content="15" Command="{Binding SetTimeframeCommand}" CommandParameter="15m"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 2. TICKER STRIP + EXIT POSITION ============ -->
        <Border Grid.Row="1" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ExitButton}" Content="⛔  Exit Indices"
                            Command="{Binding ExitIndicesCommand}" Padding="13,6" Margin="0,0,8,0"
                            ToolTip="Instantly cut all open trades in Nifty 50, Bank Nifty, and Sensex without confirmation"/>
                    <Button Style="{StaticResource ExitStocksButton}" Content="⛔  Exit Stocks"
                            Command="{Binding ExitStocksCommand}" Padding="13,6"
                            ToolTip="Instantly cut all open trades in Stock Options (Reliance, HDFC Bank, ICICI Bank, INFY, TCS) without confirmation"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Clock}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SpotText}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{Binding ChgBrush}" Margin="0,0,16,0"/>
                    <Border Background="{StaticResource TealDark}" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="0,0,14,0">
                        <TextBlock Text="{Binding State}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                    </Border>
                    <Border Background="#161616" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="0,0,14,0">
                        <TextBlock Text="{Binding FuturesText}" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding FuturesBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Expiry}" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding PosBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding PnlText}" FontFamily="Consolas" FontWeight="ExtraBold" FontSize="14" Foreground="{Binding PnlBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding PointsText}" FontFamily="Consolas" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 3. CONTENT ============ -->
        <Grid Grid.Row="2">

            <!-- ========== 1. INDEX MODE : Candlestick Chart + Option Chain ========== -->
            <Grid Visibility="{Binding IsIndexMode, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- chart -->
                <Grid Grid.Row="0">
                    <c:CandleChart Candles="{Binding Candles}" IsDaily="{Binding IsDaily}" Timeframe="{Binding Timeframe}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,6,0,0" IsHitTestVisible="False">
                        <TextBlock Text="{Binding ChartTitle}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <TextBlock Text=" · REALTIME CANDLES" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- OHLC legend -->
                <Border Grid.Row="1" Background="#0D0D0D" BorderBrush="{StaticResource Line}" BorderThickness="0,1">
                    <StackPanel Orientation="Horizontal" Margin="12,4">
                        <TextBlock Text="O " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendO}" FontFamily="Consolas" Margin="0,0,14,0"/>
                        <TextBlock Text="H " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendH}" FontFamily="Consolas" Foreground="{StaticResource Up}" Margin="0,0,14,0"/>
                        <TextBlock Text="L " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendL}" FontFamily="Consolas" Foreground="{StaticResource Down}" Margin="0,0,14,0"/>
                        <TextBlock Text="C " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendC}" FontFamily="Consolas" Margin="0,0,14,0"/>
                        <TextBlock Text="Chg " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendChg}" FontFamily="Consolas" Foreground="{Binding ChgBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="Vol " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding LegendVol}" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- bottom panel : Option Chain -->
                <Border Grid.Row="2" Background="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel Margin="10,6,10,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AtmText}" FontFamily="Consolas" Foreground="{StaticResource Amber}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentIndexName}" FontWeight="Bold" Foreground="{StaticResource Teal}" VerticalAlignment="Center"/>
                                <TextBlock Text=" OPTION CHAIN · 8 ITM" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ItemsControl ItemsSource="{Binding TopStocksConfig}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Symbol}" Command="{Binding DataContext.ViewStockOptionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="2,0" Padding="6,1" FontSize="10"
                                                    Background="#181818" BorderBrush="#333" BorderThickness="1" Foreground="#00E5FF"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>

                        <!-- group header; star widths mirror the grid columns below -->
                        <Grid Height="22" Background="#101010">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="6.8*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CALLS (CE)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Up}"/>
                            <TextBlock Grid.Column="1" Text="STRIKE" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Grid.Column="2" Text="PUTS (PE)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Down}"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Strikes}" IsReadOnly="True" IsHitTestVisible="False" Focusable="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAtm}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AtmRow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Build-up" Width="1.5*" Binding="{Binding CeBuildUp}" ElementStyle="{StaticResource BuildUpCell}"/>
                                <DataGridTextColumn Header="OI"       Width="1.2*" Binding="{Binding CeOi, StringFormat='{}{0:#,##0;-#,##0;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Volume"   Width="1.1*" Binding="{Binding CeVolume, StringFormat='{}{0:#,##0;-#,##0;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Bid"      Width="1*"   Binding="{Binding CeBid, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Ask"      Width="1*"   Binding="{Binding CeAsk, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="LTP"      Width="1*"   Binding="{Binding CeLtp, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="STRIKE"   Width="1.2*" Binding="{Binding Strike, StringFormat='{}{0:N0}'}" ElementStyle="{StaticResource StrikeCell}"/>
                                <DataGridTextColumn Header="LTP"      Width="1*"   Binding="{Binding PeLtp, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Bid"      Width="1*"   Binding="{Binding PeBid, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Ask"      Width="1*"   Binding="{Binding PeAsk, StringFormat='{}{0:0.00;-0.00;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Volume"   Width="1.1*" Binding="{Binding PeVolume, StringFormat='{}{0:#,##0;-#,##0;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="OI"       Width="1.2*" Binding="{Binding PeOi, StringFormat='{}{0:#,##0;-#,##0;—}'}" ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Build-up" Width="1.5*" Binding="{Binding PeBuildUp}" ElementStyle="{StaticResource BuildUpCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========== 2. STOCKS MODE : Full-Height NIFTY 50 Screener (No Chart) ========== -->
            <Grid Visibility="{Binding IsStocksMode, Converter={StaticResource BoolVis}}" Background="{StaticResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="10,8,10,6">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,14,0" ToolTip="Search symbol"/>

                    <TextBlock Text="Show" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <RadioButton Style="{StaticResource SegButton}" GroupName="topn" Content="Top 10" IsChecked="True" Command="{Binding SetTopNCommand}" CommandParameter="10"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="topn" Content="Top 20" Command="{Binding SetTopNCommand}" CommandParameter="20"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="topn" Content="All 50"  Command="{Binding SetTopNCommand}" CommandParameter="0"/>
                    </StackPanel>

                    <TextBlock Text="Side" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <RadioButton Style="{StaticResource SegButton}" GroupName="side" Content="All"  IsChecked="True" Command="{Binding SetSideCommand}" CommandParameter="All"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="side" Content="Buy"  Command="{Binding SetSideCommand}" CommandParameter="Buy"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="side" Content="Sell" Command="{Binding SetSideCommand}" CommandParameter="Sell"/>
                    </StackPanel>

                    <TextBlock Text="Rank by" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <RadioButton Style="{StaticResource SegButton}" GroupName="rank" Content="Volume" IsChecked="True" Command="{Binding SetRankCommand}" CommandParameter="Volume"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="rank" Content="Change %" Command="{Binding SetRankCommand}" CommandParameter="Change %"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedCount}" Foreground="{StaticResource Teal}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="⟳ Refresh" Command="{Binding RefreshStocksCommand}" Margin="0,0,6,0"/>
                    <Button Content="💾 Save Selections" Command="{Binding SaveSelectionsCommand}"/>
                </WrapPanel>

                <TextBlock Grid.Row="1" Text="{Binding StocksInfo}" Foreground="{StaticResource Muted}" FontFamily="Consolas" Margin="12,0,0,6"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Stocks}" SelectedItem="{Binding SelectedStock, Mode=TwoWay}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Symbol" Width="1.3*" Binding="{Binding Symbol}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="LTP (₹)" Width="1.1*" Binding="{Binding Price, StringFormat='{}{0:N2}'}" ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Chg %" Width="1*" Binding="{Binding ChangePct, StringFormat='{}{0:+0.00;-0.00;0.00}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
                                    <Setter Property="Foreground" Value="{Binding ChangePct, Converter={StaticResource SignBrush}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Volume" Width="1.2*" Binding="{Binding Volume, StringFormat='{}{0:N0}'}" ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Build-up" Width="1.5*" Binding="{Binding BuildUp}" ElementStyle="{StaticResource BuildUpCell}"/>
                        <DataGridTextColumn Header="Signal" Width="0.8*" Binding="{Binding Signal}" ElementStyle="{StaticResource SideCell}"/>
                        <DataGridTextColumn Header="Lot Size" Width="0.9*" Binding="{Binding LotSize}" ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTemplateColumn Header="Lots" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Lots, UpdateSourceTrigger=LostFocus}" Width="48" TextAlignment="Center" Padding="0,1" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Options" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="⚡ Chain" Command="{Binding DataContext.ViewStockOptionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Padding="6,1" Background="#1c2a2a" BorderBrush="{StaticResource Teal}" BorderThickness="1"
                                            Foreground="{StaticResource Teal}" FontSize="11" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ========== TRADES JOURNAL ========== -->
            <Grid Visibility="{Binding IsJournalMode, Converter={StaticResource BoolVis}}" Background="{StaticResource Panel}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,8,12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EXECUTED TRADES JOURNAL" FontWeight="Bold" Foreground="{StaticResource Teal}" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,14,0"/>
                        <Border Background="{StaticResource Line}" CornerRadius="3" Padding="8,2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding JournalTitleText}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Teal}" FontSize="11.5"/>
                        </Border>
                        <Border Background="{StaticResource Line}" CornerRadius="3" Padding="8,2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding JournalTradesSummaryText}" FontFamily="Consolas" Foreground="White" FontSize="11.5"/>
                        </Border>
                        <Border Background="{StaticResource Line}" CornerRadius="3" Padding="8,2">
                            <TextBlock Text="{Binding JournalTotalPnlText}" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding JournalTotalPnlBrush}" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="View Date:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5"/>
                        <ComboBox ItemsSource="{Binding AvailableTradeDates}" SelectedItem="{Binding SelectedTradeDate}" 
                                  Width="130" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                  Background="#1A1A1A" Foreground="White" BorderBrush="{StaticResource Line}"/>
                        <Button Content="📅 Today" Command="{Binding SetTodayJournalCommand}"
                                Style="{StaticResource CsvButton}" Margin="0,0,8,0" Padding="8,4"/>
                        <Button Content="📥 Export CSV" HorizontalAlignment="Right" Command="{Binding ExportTradesCsvCommand}"
                                Style="{StaticResource CsvButton}"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="1.1*" Binding="{Binding TradeId}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Date" Width="0.9*" Binding="{Binding TradeDate}" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Side" Width="0.7*" Binding="{Binding Side}" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Symbol" Width="1.8*" Binding="{Binding Symbol}" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Entry Time" Width="1*" Binding="{Binding EntryTime}" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Entry" Width="0.9*" Binding="{Binding Entry, StringFormat='{}{0:N2}'}" ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Exit Time" Width="1*" Binding="{Binding ExitTime}" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Exit" Width="0.9*" Binding="{Binding Exit, StringFormat='{}{0:0.00;—;—}'}" ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="P&amp;L (₹)" Width="1.1*" Binding="{Binding NetPnl, StringFormat='{}{0:N2}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
                                    <Setter Property="Foreground" Value="{Binding NetPnl, Converter={StaticResource SignBrush}}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Bot Speed" Width="0.9*" Binding="{Binding BotMsText}" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Status" Width="0.8*" Binding="{Binding Status}" ElementStyle="{StaticResource CenterCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ========== SETTINGS ========== -->
            <ScrollViewer Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolVis}}" Background="{StaticResource Panel}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18">
                    <!-- Section 1: Display -->
                    <TextBlock Text="DISPLAY &amp; OPTION CHAIN SETTINGS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Teal}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                        <TextBlock Text="Strikes shown in option chain" Width="240" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="strikes" Content="6"  Command="{Binding SetStrikeTotalCommand}" CommandParameter="6"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="strikes" Content="8"  IsChecked="True" Command="{Binding SetStrikeTotalCommand}" CommandParameter="8"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="strikes" Content="10" Command="{Binding SetStrikeTotalCommand}" CommandParameter="10"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="strikes" Content="12" Command="{Binding SetStrikeTotalCommand}" CommandParameter="12"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,8,0,20"/>

                    <!-- Section 2: Morning Lots Configuration -->
                    <TextBlock Text="MORNING MARKET RISK &amp; LOT CONFIGURATION (Set before 09:00 AM)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Teal}" Margin="0,0,0,6"/>
                    <TextBlock Text="Define the exact number of lots to trade for each index during automated morning entry (09:15:00 IST). Values persist to backend configuration."
                               Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

                    <!-- NIFTY 50 -->
                    <Border Background="#121212" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,12"
                            Opacity="{Binding NiftyCardOpacity}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NIFTY 50  (1 Lot = 65 Qty)" Width="220" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="1"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=1}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="2"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=2}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="3"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=3}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="3"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="4"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=4}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="4"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="5"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=5}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="5"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="niftylots" Content="10"
                                         IsChecked="{Binding NiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=10}"
                                         Command="{Binding SetNiftyLotsCommand}" CommandParameter="10"/>

                            <TextBlock Text="Custom Lots:" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox Width="50" TextAlignment="Center" Text="{Binding NiftyLots, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>

                            <Border Background="{StaticResource TealDark}" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="3" Padding="10,3" Margin="16,0,0,0">
                                <TextBlock Text="{Binding NiftyLotsPreview}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                            </Border>

                            <Button Command="{Binding ToggleNiftyEnabledCommand}" Style="{StaticResource {x:Type Button}}"
                                    Background="#181818" BorderBrush="{Binding NiftyStatusBrush}" BorderThickness="1.5"
                                    Padding="14,4" Margin="24,0,0,0" ToolTip="Click to toggle between Active and Paused today">
                                <TextBlock Text="{Binding NiftyStatusText}" FontWeight="Bold" Foreground="{Binding NiftyStatusBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- BANK NIFTY -->
                    <Border Background="#121212" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,12"
                            Opacity="{Binding BankNiftyCardOpacity}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="BANK NIFTY  (1 Lot = 15 Qty)" Width="220" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="1"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=1}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="2"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=2}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="3"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=3}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="3"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="4"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=4}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="4"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="5"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=5}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="5"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="bankniftylots" Content="10"
                                         IsChecked="{Binding BankNiftyLots, Converter={StaticResource RadioMatch}, ConverterParameter=10}"
                                         Command="{Binding SetBankNiftyLotsCommand}" CommandParameter="10"/>

                            <TextBlock Text="Custom Lots:" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox Width="50" TextAlignment="Center" Text="{Binding BankNiftyLots, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>

                            <Border Background="{StaticResource TealDark}" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="3" Padding="10,3" Margin="16,0,0,0">
                                <TextBlock Text="{Binding BankNiftyLotsPreview}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                            </Border>

                            <Button Command="{Binding ToggleBankNiftyEnabledCommand}" Style="{StaticResource {x:Type Button}}"
                                    Background="#181818" BorderBrush="{Binding BankNiftyStatusBrush}" BorderThickness="1.5"
                                    Padding="14,4" Margin="24,0,0,0" ToolTip="Click to toggle between Active and Paused today">
                                <TextBlock Text="{Binding BankNiftyStatusText}" FontWeight="Bold" Foreground="{Binding BankNiftyStatusBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- SENSEX -->
                    <Border Background="#121212" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,16"
                            Opacity="{Binding SensexCardOpacity}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SENSEX  (1 Lot = 10 Qty)" Width="220" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="1"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=1}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="2"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=2}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="2"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="3"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=3}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="3"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="4"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=4}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="4"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="5"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=5}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="5"/>
                            <RadioButton Style="{StaticResource SegButton}" GroupName="sensexlots" Content="10"
                                         IsChecked="{Binding SensexLots, Converter={StaticResource RadioMatch}, ConverterParameter=10}"
                                         Command="{Binding SetSensexLotsCommand}" CommandParameter="10"/>

                            <TextBlock Text="Custom Lots:" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox Width="50" TextAlignment="Center" Text="{Binding SensexLots, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>

                            <Border Background="{StaticResource TealDark}" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="3" Padding="10,3" Margin="16,0,0,0">
                                <TextBlock Text="{Binding SensexLotsPreview}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                            </Border>

                            <Button Command="{Binding ToggleSensexEnabledCommand}" Style="{StaticResource {x:Type Button}}"
                                    Background="#181818" BorderBrush="{Binding SensexStatusBrush}" BorderThickness="1.5"
                                    Padding="14,4" Margin="24,0,0,0" ToolTip="Click to toggle between Active and Paused today">
                                <TextBlock Text="{Binding SensexStatusText}" FontWeight="Bold" Foreground="{Binding SensexStatusBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Save Button -->
                    <Button Style="{StaticResource CsvButton}" Content="💾  Save Morning Lot Settings"
                            Command="{Binding SaveIndexLotsCommand}" Padding="18,8" FontSize="13" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                    <!-- Section 3: Top Stocks Options Trading (09:18 OI Buildup) -->
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,10,0,16"/>
                    <TextBlock Text="TOP STOCKS OPTIONS CONFIGURATION (09:18 OI BUILDUP)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Teal}" Margin="0,0,0,6"/>
                    <TextBlock Text="Select the number of Top Stocks to trade in options. Define custom lots and toggle active/paused for each stock before 09:00 AM."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Top N Selector: Top 3, Top 5, Top 10 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Choose Top Stocks to Trade:" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="settingstopn" Content="Top 3"
                                     IsChecked="{Binding SettingsTopN, Converter={StaticResource RadioMatch}, ConverterParameter=3}"
                                     Command="{Binding SetSettingsTopNCommand}" CommandParameter="3"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="settingstopn" Content="Top 5"
                                     IsChecked="{Binding SettingsTopN, Converter={StaticResource RadioMatch}, ConverterParameter=5}"
                                     Command="{Binding SetSettingsTopNCommand}" CommandParameter="5"/>
                        <RadioButton Style="{StaticResource SegButton}" GroupName="settingstopn" Content="Top 10"
                                     IsChecked="{Binding SettingsTopN, Converter={StaticResource RadioMatch}, ConverterParameter=10}"
                                     Command="{Binding SetSettingsTopNCommand}" CommandParameter="10"/>
                    </StackPanel>

                    <!-- Top Stocks Table / Card List -->
                    <DataGrid ItemsSource="{Binding TopStocksConfig}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                              BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Symbol" Width="1.4*" Binding="{Binding Symbol}" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Company Name" Width="2.4*" Binding="{Binding Name}" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Lot Size" Width="1*" Binding="{Binding LotSize}" IsReadOnly="True" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTemplateColumn Header="Lots to Trade" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Lots, UpdateSourceTrigger=LostFocus}" Width="60" TextAlignment="Center" Padding="0,2" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total Qty" Width="1.3*" Binding="{Binding QuantityPreview}" IsReadOnly="True" ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTemplateColumn Header="Today Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleStockEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource {x:Type Button}}"
                                                Background="#181818" Padding="10,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Foreground" Value="#00E676"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Foreground" Value="#FF9100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Save Stock Settings Button -->
                    <Button Style="{StaticResource CsvButton}" Content="💾  Save Stock Options Settings"
                            Command="{Binding SaveTopStocksConfigCommand}" Padding="18,8" FontSize="13" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,4,0,16"/>

                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Bot API address and demo mode are set in AppSettings.cs (or env vars GCHART_API / GCHART_DEMO=1, or run with --demo)."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 4. STATUS BAR ============ -->
        <Border Grid.Row="3" Background="#101010" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StrategySummary}" Foreground="{StaticResource Teal}" FontFamily="Consolas" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontFamily="Consolas" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
